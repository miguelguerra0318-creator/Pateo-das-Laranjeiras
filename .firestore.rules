rules_version = '2';

// Páteo Content Studio — regras de segurança do Firestore
//
// Princípio: só utilizadores autenticados (login via Firebase Auth) podem
// ler ou escrever nas colecções desta aplicação. Tudo o que não estiver
// explicitamente permitido é negado.
//
// A sócia e o dono têm contas Firebase Auth (email/password).
// O queue.js corre com Firebase Admin SDK, que ignora estas regras — usa a
// service account (chave privada). Estas regras aplicam-se apenas a acessos
// via SDK cliente (browser).

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio por defeito: qualquer caminho não coberto abaixo é negado.
    match /{document=**} {
      allow read, write: if false;
    }

    // Pedidos de conteúdo (a sócia cria; o queue.js completa).
    match /requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Base de dados de parceiros B2B (CRM-lite).
    match /partners/{partnerId} {
      allow read, write: if request.auth != null;
    }

    // Biblioteca de conteúdos aprovados/estrelados.
    match /library/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Estado do sistema (ex.: última execução do queue.js).
    // Escrita só via Admin SDK (queue.js); leitura só por utilizadores autenticados.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Imagens geradas (Nano Banana) em base64. Escritas só pelo queue.js
    // (Admin SDK); leitura só por utilizadores autenticados para a app mostrar.
    match /images/{imageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Banco de fotos sincronizado do Google Drive (miniaturas em base64,
    // agrupadas por quarto/zona). Escrito só pelo scripts/sync-photos.js
    // (Admin SDK); leitura só por utilizadores autenticados para o seletor.
    // As fotos em alta resolução ficam privadas no Drive — aqui só vivem
    // versões reduzidas.
    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
